{
  "terminology_version": "1.1.0",
  "locale": "zh-TW",
  "source_policy": {
    "preferred_term_order": [
      "repo-curriculum-and-project-confirmed",
      "repo-physics-terms",
      "moe-dictionary-for-language-form",
      "qudt-for-quantity-unit-dimension",
      "ucum-for-machine-unit-code",
      "cldr-zh-hant-for-unit-display",
      "csld-for-cross-strait-aliases",
      "om-as-fallback-ontology"
